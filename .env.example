# Left empty so the SPA uses same-origin relative requests ("/api", "/_auth").
# Only set this to an absolute origin if you must call a different host.
VITE_API_BASE_URL=""

# Relative base for the built assets so the app works under any mount path.
VITE_BASE_URL="./"

# Dev-only: where the Vite dev server proxies /api and /_auth (your Node-RED).
VITE_PROXY_TARGET="http://localhost:1880"
